# LLM API key — stored server-side only, never exposed to browser
# Claude (preferred): get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Groq fallback: get free key from console.groq.com
# GROQ_API_KEY=gsk_...

# Optional: change the API server port (default 3001)
# API_PORT=3001

# Password protection for the dashboard
DASHBOARD_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
